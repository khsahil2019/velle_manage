{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.php",
      "use": "vercel-php@0.7.1"
    }
  ],
  "routes": [
    { "src": "/api/auth/register",                    "dest": "/api/auth/register.php" },
    { "src": "/api/auth/login",                       "dest": "/api/auth/login.php" },
    { "src": "/api/auth/refresh",                     "dest": "/api/auth/refresh.php" },
    { "src": "/api/dashboard/kpis",                   "dest": "/api/dashboard/kpis.php" },
    { "src": "/api/debt-engine/plan",                 "dest": "/api/debt-engine/plan.php" },
    { "src": "/api/cards/([^/]+)/avl-update",         "dest": "/api/cards/avl-update.php" },
    { "src": "/api/cards/([^/]+)/transactions",       "dest": "/api/cards/transactions.php" },
    { "src": "/api/cards/([^/]+)",                    "dest": "/api/cards/id.php" },
    { "src": "/api/cards",                            "dest": "/api/cards/index.php" },
    { "src": "/api/loans/([^/]+)/emi-paid",           "dest": "/api/loans/emi-paid.php" },
    { "src": "/api/loans/([^/]+)",                    "dest": "/api/loans/id.php" },
    { "src": "/api/loans",                            "dest": "/api/loans/index.php" },
    { "src": "/api/payables/([^/]+)/pay",             "dest": "/api/payables/pay.php" },
    { "src": "/api/payables/([^/]+)",                 "dest": "/api/payables/id.php" },
    { "src": "/api/payables",                         "dest": "/api/payables/index.php" },
    { "src": "/api/recoveries/([^/]+)/record",        "dest": "/api/recoveries/record.php" },
    { "src": "/api/recoveries/([^/]+)",               "dest": "/api/recoveries/id.php" },
    { "src": "/api/recoveries",                       "dest": "/api/recoveries/index.php" },
    { "src": "/api/bullion/summary",                  "dest": "/api/bullion/summary.php" },
    { "src": "/api/bullion/transactions/([^/]+)",     "dest": "/api/bullion/transactions.php" },
    { "src": "/api/bullion/transactions",             "dest": "/api/bullion/transactions.php" },
    { "src": "/api/bullion",                          "dest": "/api/bullion/index.php" },
    { "src": "/api/activity",                         "dest": "/api/activity/index.php" },
    { "src": "/api/backup/export",                    "dest": "/api/backup/export.php" },
    { "src": "/api/backup/import",                    "dest": "/api/backup/import.php" },
    { "src": "/api/backup/reset-seed",                "dest": "/api/backup/reset-seed.php" },
    { "src": "/api/(.*)",                             "dest": "/api/index.php" }
  ],
  "env": {
    "DB_HOST":    "@db_host",
    "DB_NAME":    "@db_name",
    "DB_USER":    "@db_user",
    "DB_PASS":    "@db_pass",
    "DB_PORT":    "@db_port",
    "JWT_SECRET": "@jwt_secret",
    "APP_ENV":    "production"
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin",  "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Authorization, Content-Type" },
        { "key": "X-Content-Type-Options",       "value": "nosniff" },
        { "key": "X-Frame-Options",              "value": "DENY" }
      ]
    }
  ]
}
