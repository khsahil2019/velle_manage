{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "src/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/auth/register",                    "destination": "/api/auth/register.php" },
    { "source": "/api/auth/login",                       "destination": "/api/auth/login.php" },
    { "source": "/api/auth/refresh",                     "destination": "/api/auth/refresh.php" },
    { "source": "/api/dashboard/kpis",                   "destination": "/api/dashboard/kpis.php" },
    { "source": "/api/debt-engine/plan",                 "destination": "/api/debt-engine/plan.php" },
    { "source": "/api/cards/([^/]+)/avl-update",         "destination": "/api/cards/avl-update.php" },
    { "source": "/api/cards/([^/]+)/transactions",       "destination": "/api/cards/transactions.php" },
    { "source": "/api/cards/([^/]+)",                    "destination": "/api/cards/id.php" },
    { "source": "/api/cards",                            "destination": "/api/cards/index.php" },
    { "source": "/api/loans/([^/]+)/emi-paid",           "destination": "/api/loans/emi-paid.php" },
    { "source": "/api/loans/([^/]+)",                    "destination": "/api/loans/id.php" },
    { "source": "/api/loans",                            "destination": "/api/loans/index.php" },
    { "source": "/api/payables/([^/]+)/pay",             "destination": "/api/payables/pay.php" },
    { "source": "/api/payables/([^/]+)",                 "destination": "/api/payables/id.php" },
    { "source": "/api/payables",                         "destination": "/api/payables/index.php" },
    { "source": "/api/recoveries/([^/]+)/record",        "destination": "/api/recoveries/record.php" },
    { "source": "/api/recoveries/([^/]+)",               "destination": "/api/recoveries/id.php" },
    { "source": "/api/recoveries",                       "destination": "/api/recoveries/index.php" },
    { "source": "/api/bullion/summary",                  "destination": "/api/bullion/summary.php" },
    { "source": "/api/bullion/transactions/([^/]+)",     "destination": "/api/bullion/transactions.php" },
    { "source": "/api/bullion/transactions",             "destination": "/api/bullion/transactions.php" },
    { "source": "/api/bullion",                          "destination": "/api/bullion/index.php" },
    { "source": "/api/activity",                         "destination": "/api/activity/index.php" },
    { "source": "/api/backup/export",                    "destination": "/api/backup/export.php" },
    { "source": "/api/backup/import",                    "destination": "/api/backup/import.php" },
    { "source": "/api/backup/reset-seed",                "destination": "/api/backup/reset-seed.php" },
    { "source": "/(.*)",                                 "destination": "/api/index.php" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin",  "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Authorization, Content-Type, X-Requested-With" },
        { "key": "X-Content-Type-Options",       "value": "nosniff" },
        { "key": "X-Frame-Options",              "value": "DENY" }
      ]
    }
  ]
}
