# DHANFLOW Environment Variables
# Copy to .env and fill in real values
# NEVER commit .env to version control

# ── Database (PlanetScale / Clever Cloud MySQL) ─────────────────
DB_HOST=your-db-host.planetscale.dev
DB_NAME=dhanflow
DB_USER=your-db-username
DB_PASS=your-db-password
DB_PORT=3306

# ── JWT ─────────────────────────────────────────────────────────
# Generate: openssl rand -hex 64
JWT_SECRET=change_this_to_a_long_random_secret_at_least_64_chars

# ── App ─────────────────────────────────────────────────────────
APP_ENV=development
APP_URL=http://localhost:3000
CORS_ORIGIN=*

# ── Optional: Push notifications ───────────────────────────────
FCM_SERVER_KEY=your-firebase-server-key

# ── Vercel secrets (set via vercel env add) ─────────────────────
# vercel env add DB_HOST
# vercel env add DB_NAME
# vercel env add DB_USER
# vercel env add DB_PASS
# vercel env add JWT_SECRET
